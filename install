  download_comfy_models
else
  warn "Model download error:"
  printf "\n\tCannot locate hf command in PATH"
  warn "No checkpoint model downloaded"
fi
cd "${SCRIPT_PATH}"

# If we are installing an Ollama service then remove the default one
[ -f "${SCRIPT_PATH}"/etc/ollama.service ] && {
  ${SUDO} systemctl stop ollama > /dev/null 2>&1
  ${SUDO} systemctl disable ollama > /dev/null 2>&1
  ${SUDO} rm -f /etc/systemd/system/ollama.service
}

# Install systemd service units
[ -d "${SCRIPT_PATH}"/etc ] && {
  cd "${SCRIPT_PATH}"/etc
  reload=
  for script in *.service
  do
    [ "${script}" == "*.service" ] && continue
    case ${script} in
      lmstudio*)
        [ "${installStudio}" ] && {
          ${SUDO} cp ${script} /lib/systemd/system
          ${SUDO} chmod 644 /lib/systemd/system/${script}
          reload=1
        }
        ;;
      ollama*)
        [ "${installOllama}" ] && {
          ${SUDO} cp ${script} /lib/systemd/system
          ${SUDO} chmod 644 /lib/systemd/system/${script}
          reload=1
        }
        ;;
      vllm*)
        [ "${installVllm}" ] && {
          ${SUDO} cp ${script} /lib/systemd/system
          ${SUDO} chmod 644 /lib/systemd/system/${script}
          reload=1
        }
        ;;
      *)
        ${SUDO} cp ${script} /lib/systemd/system
        ${SUDO} chmod 644 /lib/systemd/system/${script}
        reload=1
        ;;
    esac
  done
  [ "${reload}" ] && ${SUDO} systemctl daemon-reload
  cd "${SCRIPT_PATH}"
}

## Nginx Installation
#
echo " ------------------ "
echo "| Installing Nginx |"
echo " ------------------ "
start_nginx=1
[ -f ${SCRIPT_PATH}/etc/nginx/ssl/server.crt ] || {
  erro "Cannot locate etc/nginx/ssl/server.crt"
  info "Nginx will not be started"
  start_nginx=
}
[ -f ${SCRIPT_PATH}/etc/nginx/ssl/server.key ] || {
  erro "Cannot locate nginx/ssl/server.key"
  info "Nginx will not be started"
  start_nginx=
}
[ "${start_nginx}" ] || {
  echo "Copy server.crt and server.key to ${SCRIPT_PATH}/etc/nginx/ssl/"
  printf "\nPress <Enter> to continue after completing ... "
  read -r yn
  printf "\n"
}

# Run Ollama behind an Nginx reverse proxy
cd "${SCRIPT_PATH}"
[ -d etc/nginx ] && {
  printf "\nInstalling and configuring nginx ... "
  ${SUDO} openssl dhparam -out /etc/ssl/certs/dhparam.pem 2048 > /dev/null 2>&1
  ${SUDO} apt install -q -y nginx > ${LOGDIR}/nginx.log 2>&1
  printf "done\n"
  ${SUDO} systemctl stop nginx
  cd etc/nginx
  [ -d /var/www/html ] || ${SUDO} mkdir -p /var/www/html
  [ -f index.html ] && {
    ${SUDO} cp index.html /var/www/html/index.html
    ${SUDO} chmod 644 /var/www/html/index.html
  }
  [ -f ollama.css ] && {
    ${SUDO} cp ollama.css /var/www/html/ollama.css
    ${SUDO} chmod 644 /var/www/html/ollama.css
  }
  [ -f favicon.ico ] && {
    ${SUDO} cp favicon.ico /var/www/html/favicon.ico
    ${SUDO} chmod 644 /var/www/html/favicon.ico
  }
  [ -f ollama.users ] && {
    ${SUDO} cp ollama.users /var/www/html/ollama.users
    ${SUDO} chmod 644 /var/www/html/ollama.users
  }
  if [ -d ssl ]; then
    DIRS="sites-available snippets ssl"
  else
    DIRS="sites-available snippets"
  fi
  ${SUDO} tar cf /tmp/nginx$$.tar ${DIRS}
  ${SUDO} tar -C /etc/nginx -xf /tmp/nginx$$.tar
  ${SUDO} rm -f /tmp/nginx$$.tar
  [ -d /etc/nginx/sites-available ] && ${SUDO} chown -R root:root /etc/nginx/sites-available
  [ -d /etc/nginx/ssl ] && ${SUDO} chown -R root:root /etc/nginx/ssl
  [ -d /etc/nginx/snippets ] && ${SUDO} chown -R root:root /etc/nginx/snippets
  if [ -f ssl/server.key ]; then
    ${SUDO} chmod 400 /etc/nginx/ssl/server.key
  else
    echo "Install /etc/nginx/ssl/server.key"
    start_nginx=
  fi
  if [ -f ssl/server.crt ]; then
    ${SUDO} chmod 400 /etc/nginx/ssl/server.crt
  else
    echo "Install /etc/nginx/ssl/server.crt"
    start_nginx=
  fi
  ${SUDO} rm -f /etc/nginx/sites-enabled/default
  [ -d /etc/nginx/sites-enabled ] || ${SUDO} mkdir -p /etc/nginx/sites-enabled
  cd /etc/nginx/sites-enabled
  for site in ../sites-available/*.neoman.dev
  do
    [ "${site}" == "../sites-available/*.neoman.dev" ] && continue
    ${SUDO} rm -f $(basename "${site}")
    ${SUDO} ln -s ${site} .
  done
  if [ "${start_nginx}" ]; then
    ${SUDO} systemctl enable nginx
    ${SUDO} systemctl start nginx
  else
    ${SUDO} systemctl stop nginx
    ${SUDO} systemctl disable nginx
  fi
  cd "${SCRIPT_PATH}"
}

# Set permissions and ownership
${SUDO} chown -R ${VLLM_USER}:${MY_GROUP} ${LLM_DATA}
${SUDO} chmod 775 ${LLM_DATA}
${SUDO} chown -R ${VLLM_USER}:${MY_GROUP} ${MNT_PT}
${SUDO} chmod 775 ${MNT_PT}
${SUDO} chown -R ${VLLM_USER}:${MY_GROUP} ${MNT_MODELS}
${SUDO} chmod 775 ${MNT_MODELS}
# Grant this user access to vllm Home
${SUDO} chown -R ${VLLM_USER}:${MY_GROUP} ${VLLM_HOME}
${SUDO} chmod 775 ${VLLM_HOME}

# Move this user's lmstudio and cache folders to mounted disk
for folder in cache lmstudio
do
  if [ -d ${HOME}/.${folder} ]; then
    ${SUDO} mv ${HOME}/.${folder} ${MNT_SHARE}/${folder}
  else
    ${SUDO} mkdir -p ${MNT_SHARE}/${folder}
  fi
  ${SUDO} chown -R ${MY_USER}:${VLLM_GROUP} ${MNT_SHARE}/${folder}
  ${SUDO} chmod 775 ${MNT_SHARE}/${folder}
  ${SUDO} ln -s ${MNT_SHARE}/${folder} ${HOME}/.${folder}
done

# Create log files and set permissions
for service in comfyui lmstudio mcp ollama openterminal openwebui vllm
do
  VARLOG="${MNT_PT}/logs/${service}"
  STDLOG="${VARLOG}/stdio.log"
  ERRLOG="${VARLOG}/error.log"
  [ -d ${VARLOG} ] || ${SUDO} mkdir -p ${VARLOG}
  ${SUDO} chown ${VLLM_USER}:${MY_GROUP} ${VARLOG}
  ${SUDO} chmod 750 ${VARLOG}
  [ -f ${STDLOG} ] || ${SUDO} touch ${STDLOG}
  [ -f ${ERRLOG} ] || ${SUDO} touch ${ERRLOG}
  ${SUDO} chown ${VLLM_USER}:${MY_GROUP} ${STDLOG}
  ${SUDO} chmod 640 ${STDLOG}
  ${SUDO} chown ${VLLM_USER}:${MY_GROUP} ${ERRLOG}
  ${SUDO} chmod 640 ${ERRLOG}
  ${SUDO} rm -rf /var/log/${service}
  ${SUDO} ln -s ${VARLOG} /var/log/${service}
done
# ComfyUI, LM Studio, and Open Terminal are being run as this user
for service in comfyui lmstudio openterminal
do
  VARLOG="${MNT_PT}/logs/${service}"
  STDLOG="${VARLOG}/stdio.log"
  ERRLOG="${VARLOG}/error.log"
  ${SUDO} chown ${MY_USER}:${VLLM_GROUP} "${VARLOG}"
  ${SUDO} chown ${MY_USER}:${VLLM_GROUP} "${STDLOG}"
  ${SUDO} chown ${MY_USER}:${VLLM_GROUP} "${ERRLOG}"
done
# Fixup log dir permissions
${SUDO} chown ${VLLM_USER}:${MY_GROUP} "${LOGDIR}"
${SUDO} chmod 775 "${LOGDIR}"

if [ "${installVllm}" ]; then
  # If vLLM installed then Ollama logs need owner Ollama
  VARLOG="${MNT_PT}/logs/ollama"
  STDLOG="${VARLOG}/stdio.log"
  ERRLOG="${VARLOG}/error.log"
  ${SUDO} chown ${VLLM_USER}:${MY_GROUP} "${VARLOG}"
  ${SUDO} chown ${VLLM_USER}:${MY_GROUP} "${STDLOG}"
  ${SUDO} chown ${VLLM_USER}:${MY_GROUP} "${ERRLOG}"

  # Download a model from Huggingface
  echo ""
  echo " ------------------------------------------------------ "
  echo "| Downloading default vLLM models from Huggingface Hub |"
  echo " ------------------------------------------------------ "
  HF_MODEL_LIST="${SCRIPT_PATH}/models/hf-init-models.txt"
  HF_PULL_LOG="${LOGDIR}/hf-init-models-download.log"
  have_hfcli=$(type -p hf)
  if [ "${have_hfcli}" ]; then
    echo ""
    echo "Huggingface Download Log" > ${HF_PULL_LOG}
    echo "------------------------" >> ${HF_PULL_LOG}
    if [ -f ${HF_MODEL_LIST} ]; then
      while IFS= read -r hfmodel
      do
        dl_hf_model "${hfmodel}"
      done < <(cat ${HF_MODEL_LIST} | grep -v "^#")
    else
      warn "Cannot locate huggingface models list file ${HF_MODEL_LIST}"
      for hfmodel in Qwen/Qwen2.5-7B-Instruct Qwen/Qwen3.5-27B-GPTQ-Int4 Qwen/Qwen3.6-27B-FP8
      do
        dl_hf_model "${hfmodel}"
      done
    fi

    echo ""
    echo " ---------------------------------------------- "
    echo "| Adding the Hugging Face CLI for Agents Skill |"
    echo " ---------------------------------------------- "
    hf skills add --force --global
  else
    erro "hf not found in PATH"
    warn "vLLM default model not downloaded"
  fi
fi

[ "${installStudio}" ] && {
  # Add LM Studio bin to PATH
  export PATH="${PATH}:${HOME}/.lmstudio/bin"
  # Download LM Studio service default models
  LMSD_LOG="${LOGDIR}/lms-models-download.log"
  echo "LM Studio Models Download Log" > ${LMSD_LOG}
  echo "-----------------------------" >> ${LMSD_LOG}
  have_lms=$(type -p lms)
  if [ "${have_lms}" ]; then
    echo ""
    echo " -------------------------------------------------------------- "
    echo "| Downloading LM Studio service models, this will take a while |"
    echo " -------------------------------------------------------------- "
    # Only download gpt-oss-20b for now
    # Additional models can be downloaded post-install
    for hf_model in gpt-oss-20b
    do
      nonl "Downloading ${hf_model} model for LM Studio ... "
      echo "Downloading ${hf_model} model" >> ${LMSD_LOG}
      lms get openai/${hf_model} --yes >> ${LMSD_LOG} 2>&1
      echo "----------------------" >> ${LMSD_LOG}
      printf "%b[done]%b\n" '\e[0;32m\033[1m' '\e[0m'
    done
  else
    warn "Cannot locate lms command, LM Studio service models not downloaded"
    echo "Cannot locate lms command, LM Studio service models not downloaded" >> ${LMSD_LOG}
  fi

  # Create symlink to LM Studio
  [ -d ${LMSTUDIO_DIR} ] && ${SUDO} rm -rf ${LMSTUDIO_DIR}
  ${SUDO} ln -s ${MNT_SHARE}/lmstudio ${LMSTUDIO_DIR}
}

${SUDO} chown -R ${VLLM_USER}:${MY_GROUP} ${MNT_PT}/.venv

# Enable and start services
for script in ${SCRIPT_PATH}/etc/*.service
do
  [ "${script}" == "${SCRIPT_PATH}/etc/*.service" ] && continue
  scrname=$(basename "${script}")
  case ${scrname} in
    lmstudio*)
      if [ "${installStudio}" ]; then
          ${SUDO} systemctl enable ${scrname} > /dev/null 2>&1
          ${SUDO} systemctl start ${scrname} > /dev/null 2>&1
      else
          ${SUDO} systemctl disable ${scrname} > /dev/null 2>&1
          ${SUDO} systemctl stop ${scrname} > /dev/null 2>&1
      fi
      ;;
    ollama*)
      if [ "${installOllama}" ]; then
          ${SUDO} systemctl enable ${scrname} > /dev/null 2>&1
          ${SUDO} systemctl start ${scrname} > /dev/null 2>&1
      else
          ${SUDO} systemctl disable ${scrname} > /dev/null 2>&1
          ${SUDO} systemctl stop ${scrname} > /dev/null 2>&1
      fi
      ;;
    vllm*)
        if [ "${installVllm}" ]; then
          ${SUDO} systemctl enable ${scrname} > /dev/null 2>&1
          ${SUDO} systemctl start ${scrname} > /dev/null 2>&1
        else
          ${SUDO} systemctl disable ${scrname} > /dev/null 2>&1
          ${SUDO} systemctl stop ${scrname} > /dev/null 2>&1
        fi
      ;;
    *)
      ${SUDO} systemctl enable ${scrname} > /dev/null 2>&1
      ${SUDO} systemctl start ${scrname} > /dev/null 2>&1
      ;;
  esac
done

# Restart Nginx
${SUDO} systemctl restart nginx

if [ "${installOllama}" ]; then
  have_ollama=$(type -p ollama)
  if [ "${have_ollama}" ]; then
    pull_models
  else
    erro "Ollama not found. Correct errors in 'curl -fSL https://ollama.com/install.sh | sh'"
  fi
fi

# Get status of newly installed systemd services
have_check=$(type -p check-services)
[ "${have_check}" ] && check-services

${SUDO} shutdown -r now
