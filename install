# Create the Open WebUI group
grep -i "^${VLLM_GROUP}:" /etc/group > /dev/null || {
  ${SUDO} groupadd ${VLLM_GROUP} 2> /dev/null
}
# Create an Open WebUI system user
id "${VLLM_USER}" > /dev/null 2>&1 || {
  ${SUDO} useradd -r -s /bin/false -g ${VLLM_GROUP} -m -d ${VLLM_HOME} ${VLLM_USER}
}
# Add the vLLM user to this user's group
add_user_group "${VLLM_USER}" "${MY_GROUP}"

# Install Open WebUI
pip install "open-webui[all]" > ${LOGDIR}/install-open-webui.log 2>&1

# Add the secret key to the Open WebUI environment file and install the env
if [ -f env-open-webui ]; then
  cp env-open-webui /tmp/owenv$$
else
  touch /tmp/owenv$$
fi
echo "WEBUI_SECRET_KEY=\"${owkey}\"" >> /tmp/owenv$$
if [ "${HF_TOKEN}" ]; then
  echo "# Huggingface access token" >> /tmp/owenv$$
  echo "HF_TOKEN=\"${HF_TOKEN}\"" >> /tmp/owenv$$
  export HF_TOKEN
else
  warn "No Huggingface access token found in environment"
fi
grep __ENABLE_OLLAMA_API__ /tmp/owenv$$ > /dev/null && {
  if [ "${installOllama}" ]; then
    enable_ollama="True"
  else
    enable_ollama="False"
  fi
  sed -i -e "s/__ENABLE_OLLAMA_API__/${enable_ollama}/" /tmp/owenv$$
}
if [ "${OPENAI_API_KEY}" ]; then
  sed -i -e "s/__OPENAI_API_KEY__/${API_PREFIX}-${OPENAI_API_KEY}/" /tmp/owenv$$
else
  warn "Missing OpenAI API key in .secrets file"
  info "Open WebUI not configured for OpenAI"
fi
if [ "${TERMINAL_API_KEY}" ]; then
  sed -i -e "s/__TERMINAL_API_KEY__/${TERMINAL_API_KEY}/" /tmp/owenv$$
else
  warn "Missing Open Terminal API key"
  info "Open WebUI not configured for Open Terminal"
fi
[ -d /etc/open-webui ] || ${SUDO} mkdir /etc/open-webui
${SUDO} cp /tmp/owenv$$ /etc/open-webui/env
${SUDO} chown ${VLLM_USER}:${MY_GROUP} /etc/open-webui/env
${SUDO} chmod 640 /etc/open-webui/env
rm -f /tmp/owenv$$

