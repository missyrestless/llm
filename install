git clone https://github.com/Comfy-Org/ComfyUI.git > /dev/null 2>&1

cd ComfyUI
pip install -r requirements.txt > ${LOGDIR}/install-ComfyUI.log 2>&1
if [ -d custom_nodes ]; then
  cd custom_nodes
  git clone https://github.com/ltdrdata/ComfyUI-Manager comfyui-manager
  cd ..
else
  warn "custom_nodes directory not found, ComfyUI Manager not installed"
