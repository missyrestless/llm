limit_req_zone $http_authorization zone=per_key:10m rate=120r/m;

upstream vllm_backend {
    server 127.0.0.1:8000;
    keepalive 64;
}

server {
    listen 80;
    server_name openai.neoman.dev;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name openai.neoman.dev;

    ssl_certificate /etc/letsencrypt/live/openai.neoman.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/openai.neoman.dev/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 100M; # Required for heavy document/model uploads
    keepalive_timeout 75s;

    location / {
        limit_req zone=per_key burst=40 nodelay;
        limit_req_status 429;

        access_log /var/log/nginx/openai-access.log;
        error_log  /var/log/nginx/openai-error.log;

        proxy_pass http://vllm_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Critical for SSE streaming
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
        chunked_transfer_encoding on;
    }
}
