server {
    listen 80;
    server_name mcp.neoman.dev;

    # Redirect to HTTPS
    if ($http_x_forwarded_proto != "https") {
        return 301 https://$server_name$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name mcp.neoman.dev;

    ssl_certificate /etc/letsencrypt/live/mcp.neoman.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcp.neoman.dev/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Proxy configuration
    location / {
        access_log /var/log/nginx/mcp-access.log;
        error_log  /var/log/nginx/mcp-error.log;

        proxy_pass https://mcp.neoman.dev:8443;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Support WebSocket and Server-Sent Events
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeout settings
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

        # Buffer settings (handling large model responses)
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location /mcp {
        access_log /var/log/nginx/mcp-access.log;
        error_log  /var/log/nginx/mcp-error.log;

        proxy_pass https://mcp.neoman.dev:8443;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Authorization $http_authorization;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Health check endpoint (optional)
    location /health {
        access_log off;
        auth_basic off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # Optimization
    client_max_body_size 100M;
    client_body_buffer_size 1M;
    client_body_timeout 60s;

    # Enable gzip compression
    gzip on;
    gzip_types text/plain application/json;
    gzip_min_length 1000;
}
